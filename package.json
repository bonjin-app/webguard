{
  "name": "webguard-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/package-metadata.mjs && turbo run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "pnpm demo:build && playwright test",
    "verify": "pnpm build && pnpm typecheck && pnpm lint && pnpm test",
    "benchmark": "node scripts/benchmark.mjs",
    "dev": "pnpm --filter @webguard/playground dev",
    "benchmark:browser": "node scripts/benchmark-browser.mjs",
    "test:package": "node scripts/verify-package-consumer.mjs",
    "demo:build": "pnpm build && node scripts/build-demo.mjs",
    "demo": "pnpm demo:build && node scripts/demo-server.mjs",
    "deploy:prepare": "node scripts/prepare-deployment.mjs",
    "deploy:types": "wrangler types deployment/worker-configuration.d.ts",
    "deploy:typecheck": "tsc -p deployment/tsconfig.json --noEmit",
    "deploy:build": "pnpm demo:build && pnpm deploy:prepare && pnpm deploy:types && pnpm deploy:typecheck",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .cloudflare-dist/bundle",
    "deploy": "pnpm deploy:build && wrangler deploy",
    "test:public": "playwright test -c playwright.public.config.ts",
    "release:prepare": "pnpm build && node scripts/release-npm.mjs prepare",
    "release:publish": "npm exec --yes --package=npm@11.21.0 -- node scripts/release-npm.mjs publish",
    "release:readback": "node scripts/release-npm.mjs readback",
    "test:npm": "node scripts/verify-npm-consumer.mjs --prepared",
    "test:npm:registry": "node scripts/verify-npm-consumer.mjs --registry"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.18.0",
    "@types/picomatch": "^4.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "tsup": "8.5.0",
    "turbo": "2.11.9",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.2"
  }
}
