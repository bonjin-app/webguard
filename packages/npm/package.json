{
  "name": "uulab-webguard",
  "version": "0.3.0",
  "description": "Build-tool independent browser application protection, advisory SDK controls, and deployment header policies.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "./dist/next-runtime.js"
  ],
  "files": [
    "dist",
    "README.md",
    "INSTALL.ko.md",
    "ENVIRONMENTS.ko.md",
    "API.ko.md",
    "API_BROWSER.ko.md",
    "API_BUILD.ko.md",
    "API_INTEGRATIONS.ko.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "examples/server.mjs"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./headers": {
      "types": "./dist/headers.d.ts",
      "import": "./dist/headers.js"
    },
    "./verify": {
      "types": "./dist/verify.d.ts",
      "import": "./dist/verify.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "import": "./dist/build.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./browser.global.js": "./dist/browser.global.js"
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "dependencies": {
    "javascript-obfuscator": "5.9.0",
    "acorn": "^8.15.0",
    "parse5": "^8.0.0",
    "picomatch": "^4.0.3"
  },
  "peerDependencies": {
    "vite": ">=7 <9"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bonjin-app/webguard.git",
    "directory": "packages/npm"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "homepage": "https://webguard.uulab.co.kr/docs/#install",
  "bin": {
    "webguard-check": "./dist/check.js",
    "webguard-serve": "./dist/serve.js",
    "webguard": "./dist/cli.js"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
